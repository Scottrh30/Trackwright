{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackwright",
  "version": "0.1.0",
  "identifier": "com.scotthambach.trackwright",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Trackwright",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 700,
        "backgroundColor": "#15171c"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Scott Hambach",
    "copyright": "© 2026 Scott Hambach. All rights reserved. Trackwright is a trademark of Scott Hambach.",
    "category": "Video",
    "shortDescription": "Planar motion tracking",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
